# Resend — contact form mailer.
# Sign up at https://resend.com (free tier: 3,000 emails/month).
# Create an API key, add it here.
RESEND_API_KEY=

# Where the contact form delivers messages.
RESEND_TO_EMAIL=kasomaibrahim@gmail.com

# From-address. Until a sender domain is verified in Resend, use the
# default `onboarding@resend.dev`. Once you verify a domain, switch to
# something like `noreply@kasomaibrahim.dev`.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Live demo (generative UI) — all free tiers, $0 spend -------------------
# Groq (primary, two models = two independent free quotas): https://console.groq.com
GROQ_API_KEY=
# Google AI Studio (backup, gemini-3.5-flash-lite): https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# Upstash Redis (per-visitor rate limit). Vercel Marketplace sets these names;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work. Unset = no limiter.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Force the model-free offline router (used by Playwright so CI spends no quota).
# DEMO_OFFLINE=1
