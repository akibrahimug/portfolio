    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.164",
    "motion": "^12",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
